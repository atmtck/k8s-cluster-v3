#!/bin/sh

version="$1"
[ -x /usr/bin/dracut ] || exit 1
[ -z "${version}" ] && exit 0

echo "dracut: generating /boot/efi/EFI/Linux/linux-${version}.efi"
dracut \
  --uefi \
  --hostonly \
  --add "crypt dm systemd-cryptsetup tpm2-tss" \
  --force \
  --kernel-cmdline "rd.luks.crypttab=no rd.luks.name=###luks_uuid###=luks_root rd.luks.options=###luks_uuid###=tpm2-device=auto,tpm2-measure-pcr=yes root=/dev/mapper/luks_root rd.shell=0 rd.emergency=reboot ro" \
  --verbose \
  "/boot/efi/EFI/Linux/linux-${version}.efi" --kver "${version}"

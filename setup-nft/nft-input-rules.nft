#!/usr/sbin/nft -f

table inet input-rules {
  chain input {
    type filter hook input priority -200; policy drop;

    ct state { established, related } accept
    iifname { "lo", "wg0", "cni0" } accept
    tcp dport { 22, 80, 443, 9000, 9500, 25565 } accept
    meta nfproto ipv6 udp dport 51820 accept

    icmp type { echo-request, destination-unreachable, time-exceeded, parameter-problem } accept

    icmpv6 type {
      echo-request, packet-too-big, time-exceeded, parameter-problem,
      nd-router-advert, nd-neighbor-solicit, nd-neighbor-advert, nd-redirect
    } accept

    ip6 saddr fe80::/10 ip6 daddr fe80::/10 udp sport 547 udp dport 546 accept

    log
  }
}
